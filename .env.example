# ─────────────────────────────────────────────────────────────────────────────
# REQUIRED — Google AI
# ─────────────────────────────────────────────────────────────────────────────
# One key drives every model call: research and scripting (Gemini 3.7 Flash),
# multi-speaker TTS, embeddings (text-embedding-004), and Veo 3.1 video.
#
#   Vertex / Agent Platform express key (starts with "AQ.")  -> recommended
#     https://console.cloud.google.com/  ->  Agent Platform  ->  API keys
#   Gemini Developer API key (starts with "AIza")
#     https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Set to "true" when GEMINI_API_KEY is an express-mode ("AQ.") key.
# Express keys ONLY work against Vertex; a plain client returns 403 without this.
GOOGLE_GENAI_USE_VERTEX=true

# Required for video generation. Long-running video operations need an explicit
# project path, which an express key cannot supply on its own, so video is
# issued over REST against this project. Video fails without it.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# Optional. Defaults to veo-3.1-generate-001.
# VERTEX_VIDEO_MODEL=veo-3.1-generate-001

# Optional. Routes ONLY video to the Gemini Developer API instead of Vertex.
# Requires AI Studio prepay credits on the key's project.
# GEMINI_VIDEO_API_KEY=
# GEMINI_VIDEO_MODEL=gemini-omni-1.1-flash

# ─────────────────────────────────────────────────────────────────────────────
# PUBLIC DEPLOYMENTS — make visitors bring their own key
# ─────────────────────────────────────────────────────────────────────────────
# Model inference is the dominant running cost. With this on, GEMINI_API_KEY
# above is never used for visitor generations: each visitor supplies their own
# key in the UI and Google bills them directly. Leave unset for local dev.
# REQUIRE_USER_API_KEYS=true
#
# Encrypts visitor keys at rest for the lifetime of their run. Required whenever
# REQUIRE_USER_API_KEYS is true.   Generate with: openssl rand -base64 32
# KEY_ENCRYPTION_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# REQUIRED — Database (PostgreSQL 16 + pgvector)
# ─────────────────────────────────────────────────────────────────────────────
# Cloud SQL for PostgreSQL, via the Cloud SQL Auth Proxy:
#   DATABASE_URL=postgresql://postgres:PASSWORD@127.0.0.1:5433/interdimensional_cable
# Or local Postgres for development:
#   DATABASE_URL=postgresql://localhost:5432/interdimensional_cable
# The pgvector extension must be enabled:  CREATE EXTENSION IF NOT EXISTS vector;
DATABASE_URL=

# ─────────────────────────────────────────────────────────────────────────────
# REQUIRED — Mux (video hosting and HLS delivery)
# ─────────────────────────────────────────────────────────────────────────────
# https://dashboard.mux.com/settings/access-tokens
# Note: the Mux free plan caps you at 10 assets. The generation workflow runs a
# capacity preflight and refuses to start rather than spend render money it
# cannot store.
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=

# Optional, for signed playback URLs.
MUX_SIGNING_KEY=
MUX_PRIVATE_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL — everything below is unused by the show pipeline
# ─────────────────────────────────────────────────────────────────────────────

# Base URL for workflow callbacks. Defaults to http://localhost:3000.
NEXT_PUBLIC_BASE_URL=

# Legacy @mux/ai translation primitives (Layer 2 caption/audio dubbing).
# Needed only if you exercise those; the show pipeline never touches them.
ELEVENLABS_API_KEY=
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Remotion Lambda, for the legacy social-clip renderer only.
REMOTION_AWS_ACCESS_KEY_ID=
REMOTION_AWS_SECRET_ACCESS_KEY=

# Fallback providers for the legacy @mux/ai summarize primitive only.
# The show pipeline is Google end to end and does not read these.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
